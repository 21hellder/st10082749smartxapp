@page "/"

<PageTitle>Smart-X</PageTitle>

<div class="home-page">

    <section class="hero-section">
        <div class="hero-badge">
            SMART-X · IoT MANAGEMENT PLATFORM
        </div>

        <h1>Smart-X</h1>

        <p class="hero-subtitle">
            Data Ingestion and Validation Gateway
        </p>

        <p class="hero-description">
            Monitor, validate and investigate telemetry from distributed
            IoT devices across smart environments.
        </p>
    </section>

    <section class="architecture-section">

        <div class="section-heading">
            <span class="section-label">PLATFORM MODULES</span>

            <h2>Choose an architectural pillar</h2>

            <p>
                All three Smart-X pillars are now implemented.
            </p>
        </div>

        <div class="pillar-grid">

            <a class="pillar-card active-card" href="/dashboard">

                <div class="pillar-top">
                    <span class="status active">ACTIVE · PART 1</span>
                    <span class="arrow">→</span>
                </div>

                <div class="pillar-icon">01</div>

                <h3>Sensor Data Ingestion and Telemetry</h3>

                <p>
                    Receive, validate and monitor simulated IoT telemetry,
                    register sensors and identify abnormal readings.
                </p>

                <div class="pillar-features">
                    <span>Telemetry</span>
                    <span>Validation</span>
                    <span>Incident Radar</span>
                </div>

            </a>

            <a class="pillar-card active-card" href="/command-stream">

                <div class="pillar-top">
                    <span class="status active">ACTIVE · PART 2</span>
                    <span class="arrow">→</span>
                </div>

                <div class="pillar-icon">02</div>

                <h3>Real-Time Command Stream and History</h3>

                <p>
                    Issue Pump and Relay overrides, browse live telemetry,
                    review command history and undo the latest command.
                </p>

                <div class="pillar-features">
                    <span>Commands</span>
                    <span>History</span>
                    <span>Part 2</span>
                </div>

            </a>

            <a class="pillar-card active-card" href="/network-topology">

                <div class="pillar-top">
                    <span class="status active">ACTIVE · PART 3</span>
                    <span class="arrow">→</span>
                </div>

                <div class="pillar-icon">03</div>

                <h3>Network Topology and Mesh Routing</h3>

                <p>
                    Visualise the IoT mesh network, run BFS/DFS traversal,
                    calculate the minimum spanning tree, and query historical
                    telemetry via an AVL tree.
                </p>

                <div class="pillar-features">
                    <span>Topology</span>
                    <span>BFS / DFS</span>
                    <span>Prim / Kruskal</span>
                    <span>AVL Range</span>
                </div>

            </a>

        </div>
    </section>

    <section class="part-status">

        <div class="status-heading">
            <span class="status-dot"></span>
            <strong>PART 1 · PART 2 · PART 3 SYSTEM STATUS</strong>
        </div>

        <p>
            Sensor ingestion, real-time command streaming, and network topology
            with mesh routing are all available.
        </p>

    </section>

</div>

