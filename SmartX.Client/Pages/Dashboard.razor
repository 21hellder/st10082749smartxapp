@page "/dashboard"
@using SmartX.Client.Models
@using SmartX.Client.Services
@implements IDisposable
@inject TelemetryHubService HubService
@inject HttpClient Http
@using System.Net.Http.Json
@using System.Text.Json

<PageTitle>Smart-X Dashboard</PageTitle>

<div class="smartx-dashboard">

<header class="dashboard-header">
    <div class="brand">
        <div class="brand-mark">SX</div>
        <div>
            <h1>SMART-X</h1>
            <p>Data Ingestion &amp; Validation Gateway</p>
        </div>
    </div>

    <div class="connection-status">
        <span class="status-dot @(HubService.IsConnected ? "online" : "offline")"></span>
        <span>@connectionText</span>
    </div>
</header>

<section class="hero">
    <div>
        <span class="eyebrow">OPERATIONS CENTRE</span>
        <h2>Telemetry Command Dashboard</h2>
        <p>
            Monitor incoming sensor telemetry, identify anomalous behaviour,
            and review active incidents in real time.
        </p>
    </div>

    <div class="live-badge">
        <span class="pulse"></span>
        LIVE DATA STREAM
    </div>
</section>

<section class="metric-grid">

    <div class="metric-card">
        <span class="metric-label">TELEMETRY READINGS</span>
        <strong>@recentTelemetry.Count</strong>
        <small>Recent readings received</small>
    </div>

    <div class="metric-card critical">
        <span class="metric-label">CRITICAL INCIDENTS</span>
        <strong>@CriticalCount</strong>
        <small>Immediate attention required</small>
    </div>

    <div class="metric-card warning">
        <span class="metric-label">WARNINGS</span>
        <strong>@WarningCount</strong>
        <small>Potential anomalies detected</small>
    </div>

    <div class="metric-card">
        <span class="metric-label">GATEWAY STATUS</span>
        <strong class="active-text">ACTIVE</strong>
        <small>Telemetry gateway operational</small>
    </div>

</section>

<section class="content-grid">

    <div class="panel">

        <div class="panel-header">
            <div>
                <span class="panel-kicker">ANOMALY MONITORING</span>
                <h3>Incident Radar</h3>
            </div>

            <span class="panel-count">
                @incidents.Count ACTIVE
            </span>
        </div>

        @if (incidents.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">?</div>
                <strong>No active incidents</strong>
                <span>The telemetry gateway has not detected an anomaly yet.</span>
            </div>
        }
        else
        {
            <div class="incident-list">

                @foreach (var incident in incidents.Take(10))
                {
                    <div class="incident-item @(incident.Severity.ToLower())">

                        <div class="severity">
                            <span class="severity-dot"></span>
                            @incident.Severity.ToUpper()
                        </div>

                        <div class="incident-details">
                            <strong>@incident.Message</strong>

                            <div class="incident-meta">
                                <span>@incident.DeviceId</span>
                                <span>@incident.Metric</span>
                                <span>@incident.CurrentValue @incident.Unit</span>
                            </div>
                        </div>

                        <div class="difference">
                            @if (incident.Difference >= 0)
                            {
                                <span>+@incident.Difference.ToString("0.##")</span>
                            }
                            else
                            {
                                <span>@incident.Difference.ToString("0.##")</span>
                            }
                        </div>

                    </div>
                }

            </div>
        }

    </div>

    <div class="panel">

        <div class="panel-header">
            <div>
                <span class="panel-kicker">STREAM MONITOR</span>
                <h3>Live Telemetry</h3>
            </div>

            <span class="live-indicator">
                <span class="pulse"></span>
                LIVE
            </span>
        </div>

        @if (recentTelemetry.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">?</div>
                <strong>Waiting for telemetry</strong>
                <span>Incoming sensor readings will appear here.</span>
            </div>
        }
        else
        {
            <div class="telemetry-table">

                <div class="telemetry-row heading">
                    <span>DEVICE</span>
                    <span>METRIC</span>
                    <span>VALUE</span>
                    <span>TIME</span>
                </div>

                @foreach (var reading in recentTelemetry.Take(10))
                {
                    <div class="telemetry-row">
                        <span class="device">@reading.DeviceId</span>
                        <span>@reading.Metric</span>
                        <strong>@reading.Value @reading.Unit</strong>
                        <span class="time">
                            @reading.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                        </span>
                    </div>
                }

            </div>
        }

    </div>

</section>

<section class="panel architecture">

    <div class="panel-header">
        <div>
            <span class="panel-kicker">SMART-X ARCHITECTURE</span>
            <h3>Gateway Processing Pipeline</h3>
        </div>
    </div>

    <div class="pipeline">

        <div class="pipeline-node">
            <span>01</span>
            <strong>ESP32</strong>
            <small>Sensor Devices</small>
        </div>

        <div class="line"></div>

        <div class="pipeline-node">
            <span>02</span>
            <strong>INGESTION</strong>
            <small>Telemetry Gateway</small>
        </div>

        <div class="line"></div>

        <div class="pipeline-node">
            <span>03</span>
            <strong>VALIDATION</strong>
            <small>Data Verification</small>
        </div>

        <div class="line"></div>

        <div class="pipeline-node">
            <span>04</span>
            <strong>ANALYSIS</strong>
            <small>Anomaly Detection</small>
        </div>

        <div class="line"></div>

        <div class="pipeline-node">
            <span>05</span>
            <strong>RADAR</strong>
            <small>Incident Monitoring</small>
        </div>

    </div>

</section>

<footer>
    <span>SMART-X DATA INGESTION &amp; VALIDATION GATEWAY</span>
    <span>PART 1 • REAL-TIME TELEMETRY</span>
</footer>

</div>

