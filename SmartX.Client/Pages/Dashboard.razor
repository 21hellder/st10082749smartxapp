@code {

    private readonly List<TelemetryReading> recentTelemetry = new();
    private readonly List<TelemetryIncident> incidents = new();

    private string connectionText = "CONNECTING...";
    private bool disposed;

    private const string ApiBase = "http://localhost:5187";

    private int CriticalCount =>
        incidents.Count(x =>
            x.Severity.Equals("Critical", StringComparison.OrdinalIgnoreCase));

    private int WarningCount =>
        incidents.Count(x =>
            x.Severity.Equals("Warning", StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        HubService.TelemetryReceived += HandleTelemetry;
        HubService.IncidentReceived += HandleIncident;

        // ★ Bug 1 fix: load existing data BEFORE SignalR pushes live updates
        await LoadInitialDataAsync();

        try
        {
            await HubService.StartAsync();
            connectionText = HubService.IsConnected ? "SYSTEM ONLINE" : "CONNECTING...";
        }
        catch
        {
            connectionText = "CONNECTION ERROR";
        }

        await InvokeAsync(StateHasChanged);
    }

    // ─────────────────────────────────────────────────────────────
    // INITIAL DATA LOAD (what was missing)
    // ─────────────────────────────────────────────────────────────

    private async Task LoadInitialDataAsync()
    {
        try
        {
            var history = await Http.GetFromJsonAsync<List<TelemetryReading>>(
                $"{ApiBase}/api/telemetry/history");

            if (history is not null)
            {
                recentTelemetry.Clear();
                foreach (var r in history
                    .OrderByDescending(r => r.Timestamp)
                    .Take(20))
                {
                    recentTelemetry.Add(r);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard] telemetry load failed: {ex.Message}");
        }

        try
        {
            using var response = await Http.GetAsync($"{ApiBase}/api/incidents");
            response.EnsureSuccessStatusCode();

            await using var stream = await response.Content.ReadAsStreamAsync();
            using var document = await JsonDocument.ParseAsync(stream);

            if (document.RootElement.TryGetProperty("incidents", out var arr) &&
                arr.ValueKind == JsonValueKind.Array)
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var loaded = new List<TelemetryIncident>();

                foreach (var item in arr.EnumerateArray())
                {
                    var incident = JsonSerializer.Deserialize<TelemetryIncident>(
                        item.GetRawText(), options);
                    if (incident is not null) loaded.Add(incident);
                }

                incidents.Clear();
                foreach (var i in loaded
                    .Where(i => !i.IsResolved)
                    .OrderByDescending(i => i.Timestamp)
                    .Take(20))
                {
                    incidents.Add(i);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard] incident load failed: {ex.Message}");
        }
    }

    // ─────────────────────────────────────────────────────────────
    // SIGNALR HANDLERS
    // ─────────────────────────────────────────────────────────────

    private void HandleTelemetry(TelemetryReading reading)
    {
        if (disposed) return;

        _ = InvokeAsync(() =>
        {
            recentTelemetry.Insert(0, reading);

            if (recentTelemetry.Count > 20)
                recentTelemetry.RemoveAt(recentTelemetry.Count - 1);

            StateHasChanged();
        });
    }

    private void HandleIncident(TelemetryIncident incident)
    {
        if (disposed) return;

        _ = InvokeAsync(() =>
        {
            incidents.Insert(0, incident);

            if (incidents.Count > 20)
                incidents.RemoveAt(incidents.Count - 1);

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        if (disposed) return;
        disposed = true;

        HubService.TelemetryReceived -= HandleTelemetry;
        HubService.IncidentReceived -= HandleIncident;
    }
}