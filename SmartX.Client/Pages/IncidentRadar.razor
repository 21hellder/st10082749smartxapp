@page "/incident-radar"
@implements IDisposable
@using SmartX.Client.Models
@inject SmartX.Client.Services.TelemetryHubService HubService

<PageTitle>Incident Radar | Smart-X</PageTitle>

<div class="radar-page">

    <div class="radar-header">
        <div>
            <div class="eyebrow">SMART-X / INCIDENT MONITORING</div>
            <h1>Incident Radar</h1>
            <p>Real-time anomaly detection and sensor health monitoring.</p>
        </div>

        <div class="connection-status">
            <span class="status-dot"></span>
            @connectionText
        </div>
    </div>

    <div class="summary-grid">

        <div class="summary-card critical-card">
            <div class="summary-label">CRITICAL</div>
            <div class="summary-value">@CriticalCount</div>
            <div class="summary-description">Immediate attention required</div>
        </div>

        <div class="summary-card warning-card">
            <div class="summary-label">WARNINGS</div>
            <div class="summary-value">@WarningCount</div>
            <div class="summary-description">Unusual telemetry detected</div>
        </div>

        <div class="summary-card">
            <div class="summary-label">TOTAL INCIDENTS</div>
            <div class="summary-value">@incidents.Count</div>
            <div class="summary-description">Detected during this session</div>
        </div>

        <div class="summary-card">
            <div class="summary-label">MONITORED DEVICES</div>
            <div class="summary-value">@DeviceCount</div>
            <div class="summary-description">Unique ESP32 devices</div>
        </div>

    </div>

    <div class="radar-section">

        <div class="section-heading">
            <div>
                <div class="eyebrow">LIVE DETECTION</div>
                <h2>Active Incidents</h2>
            </div>

            <button class="clear-button" @onclick="ClearIncidents">
                CLEAR RADAR
            </button>
        </div>

        @if (incidents.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">✓</div>
                <h3>No active incidents</h3>
                <p>
                    Smart-X is monitoring incoming telemetry.
                    Critical and warning anomalies will appear here automatically.
                </p>
            </div>
        }
        else
        {
            <div class="incident-list">

                @foreach (var incident in incidents)
                {
                    <div class="incident-card @(incident.Severity.Equals("Critical", StringComparison.OrdinalIgnoreCase) ? "critical" : "warning")">

                        <div class="incident-indicator"></div>

                        <div class="incident-main">

                            <div class="incident-top">
                                <span class="severity">
                                    @incident.Severity
                                </span>

                                <span class="incident-time">
                                    @incident.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                                </span>
                            </div>

                            <h3>@incident.Message</h3>

                            <div class="incident-device">
                                <span>DEVICE</span>
                                <strong>@incident.DeviceId</strong>
                            </div>

                            <div class="incident-metric">
                                <span>METRIC</span>
                                <strong>@incident.Metric</strong>
                            </div>

                        </div>

                        <div class="incident-values">

                            <div class="value-block">
                                <span>PREVIOUS</span>
                                <strong>@incident.PreviousValue.ToString("0.##") @incident.Unit</strong>
                            </div>

                            <div class="value-arrow">→</div>

                            <div class="value-block current">
                                <span>CURRENT</span>
                                <strong>@incident.CurrentValue.ToString("0.##") @incident.Unit</strong>
                            </div>

                            <div class="value-block">
                                <span>CHANGE</span>
                                <strong>@incident.Difference.ToString("+0.##;-0.##;0") @incident.Unit</strong>
                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

    <div class="radar-info">

        <div class="info-icon">i</div>

        <div>
            <h3>How Incident Radar works</h3>
            <p>
                Telemetry is received from ESP32 devices and processed by the
                .NET 10 API. The validation service checks the incoming data,
                while the anomaly detection service compares readings and
                identifies unusual values. SignalR then pushes new incidents
                directly to this interface without requiring a page refresh.
            </p>
        </div>

    </div>

</div>

<style>
