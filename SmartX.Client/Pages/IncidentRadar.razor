</style>

@code {

    private readonly List<TelemetryIncident> incidents = new();

    private string connectionText = "CONNECTING...";

    private int CriticalCount =>
        incidents.Count(x =>
            x.Severity.Equals(
                "Critical",
                StringComparison.OrdinalIgnoreCase));

    private int WarningCount =>
        incidents.Count(x =>
            x.Severity.Equals(
                "Warning",
                StringComparison.OrdinalIgnoreCase));

    private int DeviceCount =>
        incidents
            .Select(x => x.DeviceId)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

    protected override async Task OnInitializedAsync()
    {
        HubService.IncidentReceived += HandleIncident;

        try
        {
            await HubService.StartAsync();

            connectionText = HubService.IsConnected
                ? "SYSTEM ONLINE"
                : "DISCONNECTED";
        }
        catch
        {
            connectionText = "CONNECTION ERROR";
        }
    }

    private void HandleIncident(TelemetryIncident incident)
    {
        incidents.Insert(0, incident);

        if (incidents.Count > 50)
        {
            incidents.RemoveAt(incidents.Count - 1);
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void ClearIncidents()
    {
        incidents.Clear();
    }

    public void Dispose()
    {
        HubService.IncidentReceived -= HandleIncident;
    }
}