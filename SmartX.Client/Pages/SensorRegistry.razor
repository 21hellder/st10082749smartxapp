@page "/sensor-registry"
@using System.Net.Http.Json
@using SmartX.Client.Models
@inject HttpClient Http

<PageTitle>Sensor Registry | Smart-X</PageTitle>

<div class="registry-page">

<div class="page-header">
    <div>
        <div class="eyebrow">SMART-X / DEVICE MANAGEMENT</div>
        <h1>Sensor Registry</h1>
        <p>Register and monitor connected IoT sensors across the Smart-X environment.</p>
    </div>

    <button type="button" class="refresh-button" @onclick="LoadSensors">
        ↻ Refresh
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="message">@message</div>
}

<div class="stats-grid">

    <div class="stat-card">
        <span class="stat-label">TOTAL SENSORS</span>
        <strong>@sensors.Count</strong>
    </div>

    <div class="stat-card online">
        <span class="stat-label">ONLINE</span>
        <strong>@sensors.Count(x => x.IsOnline)</strong>
    </div>

    <div class="stat-card offline">
        <span class="stat-label">OFFLINE</span>
        <strong>@sensors.Count(x => !x.IsOnline)</strong>
    </div>

    <div class="stat-card">
        <span class="stat-label">LOCATIONS</span>
        <strong>@sensors.Select(x => x.Location).Distinct().Count()</strong>
    </div>

</div>

<div class="content-grid">

    <section class="panel">

        <div class="panel-header">
            <div>
                <span class="panel-tag">REGISTER DEVICE</span>
                <h2>Add Sensor</h2>
            </div>
        </div>

        <div class="form-grid">

            <div class="form-field">
                <label>Device ID</label>
                <input @bind="newSensor.DeviceId"
                       placeholder="ESP32-001" />
            </div>

            <div class="form-field">
                <label>MAC Address</label>
                <input @bind="newSensor.MacAddress"
                       placeholder="AA:BB:CC:DD:EE:01" />
            </div>

            <div class="form-field">
                <label>Deployment Location</label>
                <input @bind="newSensor.Location"
                       placeholder="Hydroponic Zone A" />
            </div>

            <div class="form-field">
                <label>Category</label>

                <select @bind="newSensor.Category">
                    <option value="">Select category</option>
                    <option value="Environmental">Environmental</option>
                    <option value="Power Consumption">Power Consumption</option>
                    <option value="Actuator">Actuator</option>
                </select>
            </div>

        </div>

        <button type="button"
                class="register-button"
                @onclick="RegisterSensor">
            + Register Sensor
        </button>

    </section>

    <section class="panel information-panel">

        <div class="panel-header">
            <div>
                <span class="panel-tag">SYSTEM INFORMATION</span>
                <h2>Registry Status</h2>
            </div>
        </div>

        <div class="info-row">
            <span>Registration</span>
            <strong>ACTIVE</strong>
        </div>

        <div class="info-row">
            <span>Identity</span>
            <strong>MAC / DEVICE ID</strong>
        </div>

        <div class="info-row">
            <span>Telemetry</span>
            <strong>MONITORED</strong>
        </div>

        <div class="info-row">
            <span>Categories</span>
            <strong>3 TYPES</strong>
        </div>

    </section>

</div>

<section class="panel sensor-table-panel">

    <div class="panel-header">
        <div>
            <span class="panel-tag">REGISTERED DEVICES</span>
            <h2>Sensor Inventory</h2>
        </div>

        <span class="sensor-count">@sensors.Count devices</span>
    </div>

    @if (loading)
    {
        <div class="empty-state">
            Loading sensor registry...
        </div>
    }
    else if (sensors.Count == 0)
    {
        <div class="empty-state">
            No sensors have been registered yet.
        </div>
    }
    else
    {
        <div class="table-wrapper">

            <table>

                <thead>
                    <tr>
                        <th>STATUS</th>
                        <th>DEVICE ID</th>
                        <th>MAC ADDRESS</th>
                        <th>LOCATION</th>
                        <th>CATEGORY</th>
                        <th>LAST TELEMETRY</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var sensor in sensors)
                    {
                        <tr>

                            <td>
                                @if (sensor.IsOnline)
                                {
                                    <span class="status online-status">
                                        <span class="status-dot"></span>
                                        ONLINE
                                    </span>
                                }
                                else
                                {
                                    <span class="status offline-status">
                                        <span class="status-dot"></span>
                                        OFFLINE
                                    </span>
                                }
                            </td>

                            <td>
                                <strong>@sensor.DeviceId</strong>
                            </td>

                            <td class="mono">
                                @sensor.MacAddress
                            </td>

                            <td>
                                @sensor.Location
                            </td>

                            <td>
                                <span class="category">
                                    @sensor.Category
                                </span>
                            </td>

                            <td class="timestamp">
                                @sensor.LastTelemetryReceived.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</section>

</div>

<style>

    .registry-page {
        min-height: 100vh;
        padding: 36px;
        background: #080b10;
        color: #f2f4f7;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 28px;
    }

    .eyebrow,
    .panel-tag,
    .stat-label {
        color: #7f8a9a;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    h1 {
        margin: 8px 0;
        font-size: 34px;
        letter-spacing: -1px;
    }

    h2 {
        margin: 7px 0 0;
        font-size: 20px;
    }

    .page-header p {
        margin: 0;
        color: #87909d;
    }

    .refresh-button {
        padding: 11px 18px;
        border: 1px solid #26303c;
        border-radius: 8px;
        background: #10151c;
        color: #dce2e8;
        cursor: pointer;
    }

    .refresh-button:hover {
        background: #171d25;
    }

    .message {
        padding: 12px 16px;
        margin-bottom: 20px;
        border: 1px solid #26303c;
        border-radius: 8px;
        background: #10151c;
        color: #b9c3ce;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .stat-card {
        padding: 20px;
        border: 1px solid #202833;
        border-radius: 10px;
        background: #0d1218;
    }

    .stat-card strong {
        display: block;
        margin-top: 10px;
        font-size: 27px;
    }

    .stat-card.online strong {
        color: #63d98b;
    }

    .stat-card.offline strong {
        color: #e47b7b;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .panel {
        border: 1px solid #202833;
        border-radius: 10px;
        background: #0d1218;
        overflow: hidden;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 22px;
        border-bottom: 1px solid #202833;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        padding: 22px;
    }

    .form-field label {
        display: block;
        margin-bottom: 7px;
        color: #8e98a5;
        font-size: 12px;
        font-weight: 600;
    }

    .form-field input,
    .form-field select {
        width: 100%;
        box-sizing: border-box;
        padding: 11px 12px;
        border: 1px solid #29323d;
        border-radius: 7px;
        background: #080b10;
        color: #e9edf2;
        outline: none;
    }

    .form-field input:focus,
    .form-field select:focus {
        border-color: #5e6a78;
    }

    .register-button {
        margin: 0 22px 22px;
        padding: 11px 18px;
        border: 0;
        border-radius: 7px;
        background: #e7ebef;
        color: #080b10;
        font-weight: 700;
        cursor: pointer;
    }

    .register-button:hover {
        background: #ffffff;
    }

    .information-panel {
        padding-bottom: 10px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 15px 22px;
        border-bottom: 1px solid #1b222b;
        color: #8d97a4;
        font-size: 13px;
    }

    .info-row strong {
        color: #d9dfe5;
        font-size: 11px;
    }

    .sensor-table-panel {
        margin-bottom: 40px;
    }

    .sensor-count {
        color: #7f8a96;
        font-size: 12px;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        padding: 13px 18px;
        text-align: left;
        color: #707b89;
        font-size: 10px;
        letter-spacing: 1.2px;
        font-weight: 700;
        border-bottom: 1px solid #202833;
        white-space: nowrap;
    }

    td {
        padding: 16px 18px;
        border-bottom: 1px solid #171e26;
        color: #aeb7c2;
        font-size: 13px;
        white-space: nowrap;
    }

    tr:hover td {
        background: #10161d;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .online-status {
        color: #63d98b;
    }

    .offline-status {
        color: #e47b7b;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    .mono {
        font-family: Consolas, monospace;
        color: #8994a2;
    }

    .category {
        padding: 5px 8px;
        border: 1px solid #29323d;
        border-radius: 5px;
        color: #aeb8c3;
        font-size: 11px;
    }

    .timestamp {
        color: #77818e;
        font-family: Consolas, monospace;
        font-size: 11px;
    }

    .empty-state {
        padding: 50px;
        text-align: center;
        color: #697482;
    }

</style>

@code {

private readonly List<Sensor> sensors = new();

private Sensor newSensor = new();

private bool loading = true;

private string message = string.Empty;

protected override async Task OnInitializedAsync()
{
    await LoadSensors();
}

private async Task LoadSensors()
{
    loading = true;
    message = string.Empty;

    try
    {
        var result =
            await Http.GetFromJsonAsync<SensorListResponse>(
                "http://localhost:5187/api/sensors");

        sensors.Clear();

        if (result?.Sensors != null)
        {
            sensors.AddRange(result.Sensors);
        }
    }
    catch (Exception ex)
    {
        message = $"Unable to load the sensor registry: {ex.Message}";
    }
    finally
    {
        loading = false;
    }
}

private async Task RegisterSensor()
{
    message = string.Empty;

    if (string.IsNullOrWhiteSpace(newSensor.DeviceId) ||
        string.IsNullOrWhiteSpace(newSensor.MacAddress) ||
        string.IsNullOrWhiteSpace(newSensor.Location) ||
        string.IsNullOrWhiteSpace(newSensor.Category))
    {
        message = "Please complete all sensor registration fields.";
        return;
    }

    try
    {
        var response =
            await Http.PostAsJsonAsync(
                "http://localhost:5187/api/sensors",
                newSensor);

        if (response.IsSuccessStatusCode)
        {
            message = "Sensor registered successfully.";

            newSensor = new Sensor();

            await LoadSensors();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();

            message = $"Sensor registration failed: {error}";
        }
    }
    catch (Exception ex)
    {
        message = $"Unable to register the sensor: {ex.Message}";
    }
}

private class SensorListResponse
{
    public bool Success { get; set; }

    public List<Sensor> Sensors { get; set; } = new();
}


}
