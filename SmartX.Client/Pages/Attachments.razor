@page "/attachments"

@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using SmartX.Client.Models

@inject HttpClient Http

<div class="attachments-page">

    <div class="page-header">
        <div>
            <div class="eyebrow">SMART-X / SENSOR MANAGEMENT</div>
            <h1>Sensor Attachments</h1>
            <p>Upload configuration files, deployment photos and hardware logs to a registered sensor.</p>
        </div>

        <div class="header-status">
            <span class="status-dot"></span>
            API CONNECTED
        </div>
    </div>

    <div class="content-grid">

        <section class="panel upload-panel">

            <div class="panel-header">
                <div>
                    <h2>Upload Attachment</h2>
                    <p>Attach a file to a registered sensor.</p>
                </div>
            </div>

            <div class="form-group">
                <label>Select Sensor</label>

                <select class="form-control"
                        @bind="selectedDeviceId"
                        @bind:after="SensorChanged">

                    <option value="">-- Select a sensor --</option>

                    @foreach (var sensor in sensors)
                    {
                        <option value="@sensor.DeviceId">
                            @sensor.DeviceId — @sensor.Location
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Choose File</label>

                <InputFile OnChange="HandleFileSelected"
                           class="file-input" />

                @if (selectedFile != null)
                {
                    <div class="selected-file">
                        <div>
                            <strong>@selectedFile.Name</strong>
                            <span>@FormatFileSize(selectedFile.Size)</span>
                        </div>

                        <button type="button"
                                class="remove-button"
                                @onclick="ClearSelectedFile">
                            Remove
                        </button>
                    </div>
                }
            </div>

            <div class="upload-info">
                <div>
                    <strong>Maximum file size</strong>
                    <span>10 MB</span>
                </div>

                <div>
                    <strong>Supported formats</strong>
                    <span>JSON, TXT, LOG, CSV, XML, JPG, JPEG, PNG, PDF</span>
                </div>
            </div>

            <button class="upload-button"
                    @onclick="UploadFile"
                    disabled="@(!CanUpload || uploading)">

                @if (uploading)
                {
                    <span>Uploading...</span>
                }
                else
                {
                    <span>Upload File</span>
                }
            </button>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="message @messageType">
                    @message
                </div>
            }

        </section>


        <section class="panel attachments-panel">

            <div class="panel-header">
                <div>
                    <h2>Sensor Files</h2>

                    @if (!string.IsNullOrWhiteSpace(selectedDeviceId))
                    {
                        <p>Files attached to <strong>@selectedDeviceId</strong>.</p>
                    }
                    else
                    {
                        <p>Select a sensor to view its attachments.</p>
                    }
                </div>

                <button class="refresh-button"
                        @onclick="LoadAttachments"
                        disabled="@string.IsNullOrWhiteSpace(selectedDeviceId)">
                    Refresh
                </button>
            </div>

            @if (loadingAttachments)
            {
                <div class="empty-state">
                    <div class="loader"></div>
                    <p>Loading attachments...</p>
                </div>
            }
            else if (string.IsNullOrWhiteSpace(selectedDeviceId))
            {
                <div class="empty-state">
                    <div class="empty-icon">📁</div>
                    <h3>No sensor selected</h3>
                    <p>Select a registered sensor to view its files.</p>
                </div>
            }
            else if (attachments.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">📄</div>
                    <h3>No attachments</h3>
                    <p>This sensor does not have any uploaded files yet.</p>
                </div>
            }
            else
            {
                <div class="attachment-list">

                    @foreach (var attachment in attachments)
                    {
                        <div class="attachment-card">

                            <div class="file-icon">
                                @GetFileIcon(attachment.FileName)
                            </div>

                            <div class="file-details">
                                <strong>@attachment.FileName</strong>

                                <span>
                                    @FormatFileSize(attachment.FileSize)
                                    ·
                                    @attachment.ContentType
                                </span>

                                <small>
                                    Uploaded @attachment.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                </small>
                            </div>

                            <a class="download-button"
                               href="@GetDownloadUrl(attachment.Id)"
                               target="_blank">
                                Download
                            </a>

                        </div>
                    }

                </div>
            }

        </section>

    </div>

</div>


