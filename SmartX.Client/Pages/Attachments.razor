@code {

    private List<Sensor> sensors = new();

    private List<SensorAttachment> attachments = new();

    private string selectedDeviceId = string.Empty;

    private IBrowserFile? selectedFile;

    private bool uploading;

    private bool loadingAttachments;

    private string message = string.Empty;

    private string messageType = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadSensors();
    }

    private async Task LoadSensors()
    {
        try
        {
            var result =
                await Http.GetFromJsonAsync<SensorResponse>(
                    "http://localhost:5187/api/sensors");

            sensors = result?.Sensors ?? new List<Sensor>();

            if (!string.IsNullOrWhiteSpace(selectedDeviceId))
            {
                await LoadAttachments();
            }
        }
        catch (Exception ex)
        {
            sensors = new List<Sensor>();

            ShowMessage(
                $"Could not load sensors: {ex.Message}",
                "error");
        }
    }

    private async Task SensorChanged()
    {
        message = string.Empty;
        messageType = string.Empty;

        attachments = new List<SensorAttachment>();

        if (!string.IsNullOrWhiteSpace(selectedDeviceId))
        {
            await LoadAttachments();
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        message = string.Empty;
        messageType = string.Empty;

        selectedFile = e.File;

        if (selectedFile != null &&
            selectedFile.Size > 10 * 1024 * 1024)
        {
            selectedFile = null;

            ShowMessage(
                "File is too large. Maximum size is 10 MB.",
                "error");
        }
    }

    private void ClearSelectedFile()
    {
        selectedFile = null;

        message = string.Empty;
        messageType = string.Empty;
    }

    private bool CanUpload =>
        !uploading &&
        selectedFile != null &&
        !string.IsNullOrWhiteSpace(selectedDeviceId);

    private async Task UploadFile()
    {
        if (!CanUpload || selectedFile == null)
        {
            return;
        }

        uploading = true;
        message = string.Empty;
        messageType = string.Empty;

        try
        {
            const long maxFileSize = 10 * 1024 * 1024;

            if (selectedFile.Size > maxFileSize)
            {
                ShowMessage(
                    "File is too large. Maximum size is 10 MB.",
                    "error");

                return;
            }

            using var content = new MultipartFormDataContent();

            await using var fileStream =
                selectedFile.OpenReadStream(
                    maxAllowedSize: maxFileSize);

            using var streamContent =
                new StreamContent(fileStream);

            streamContent.Headers.ContentType =
                new MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(selectedFile.ContentType)
                        ? "application/octet-stream"
                        : selectedFile.ContentType);

            content.Add(
                streamContent,
                "file",
                selectedFile.Name);

            var response =
                await Http.PostAsync(
                    $"http://localhost:5187/api/sensors/{Uri.EscapeDataString(selectedDeviceId)}/attachments",
                    content);

            var responseText =
                await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                ShowMessage(
                    "File uploaded successfully.",
                    "success");

                selectedFile = null;

                await LoadAttachments();
            }
            else
            {
                ShowMessage(
                    $"Upload failed: {responseText}",
                    "error");
            }
        }
        catch (IOException ex)
        {
            ShowMessage(
                $"File could not be read: {ex.Message}",
                "error");
        }
        catch (Exception ex)
        {
            ShowMessage(
                $"Upload failed: {ex.Message}",
                "error");
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task LoadAttachments()
    {
        if (string.IsNullOrWhiteSpace(selectedDeviceId))
        {
            attachments = new List<SensorAttachment>();
            return;
        }

        loadingAttachments = true;

        try
        {
            var result =
                await Http.GetFromJsonAsync<AttachmentResponse>(
                    $"http://localhost:5187/api/sensors/{Uri.EscapeDataString(selectedDeviceId)}/attachments");

            attachments =
                result?.Attachments ??
                new List<SensorAttachment>();
        }
        catch (Exception ex)
        {
            attachments = new List<SensorAttachment>();

            ShowMessage(
                $"Could not load attachments: {ex.Message}",
                "error");
        }
        finally
        {
            loadingAttachments = false;
        }
    }

    private string GetDownloadUrl(string attachmentId)
    {
        return
            $"http://localhost:5187/api/sensors/attachments/{Uri.EscapeDataString(attachmentId)}/download";
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024.0:F1} KB";
        }

        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }

    private static string GetFileIcon(string fileName)
    {
        string extension =
            Path.GetExtension(fileName)
                .ToLowerInvariant();

        return extension switch
        {
            ".pdf" => "📕",
            ".json" => "📋",
            ".txt" => "📄",
            ".log" => "📝",
            ".csv" => "📊",
            ".xml" => "🗂️",
            ".jpg" => "🖼️",
            ".jpeg" => "🖼️",
            ".png" => "🖼️",
            _ => "📎"
        };
    }

    private void ShowMessage(
        string text,
        string type)
    {
        message = text;
        messageType = type;
    }

    private class SensorResponse
    {
        public bool Success { get; set; }

        public List<Sensor> Sensors { get; set; } = new();
    }

    private class AttachmentResponse
    {
        public bool Success { get; set; }

        public int Count { get; set; }

        public List<SensorAttachment> Attachments { get; set; } = new();
    }

    private class SensorAttachment
    {
        public string Id { get; set; } = string.Empty;

        public string SensorId { get; set; } = string.Empty;

        public string FileName { get; set; } = string.Empty;

        public string ContentType { get; set; } = string.Empty;

        public long FileSize { get; set; }

        public DateTime UploadedAt { get; set; }
    }
}