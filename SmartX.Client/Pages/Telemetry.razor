    }

    .empty-icon {
        margin-bottom: 15px;
        color: #6874ff;
        font-size: 30px;
    }

    .empty-state h3 {
        margin: 0 0 7px;
        font-size: 17px;
    }

    .empty-state p {
        max-width: 450px;
        margin: auto;
        color: #687284;
        font-size: 12px;
        line-height: 1.6;
    }

    .info-panel {
        display: flex;
        gap: 14px;
        margin-top: 20px;
        padding: 18px 20px;
        border: 1px solid rgba(124,140,255,.12);
        border-radius: 10px;
        background: rgba(124,140,255,.035);
    }

    .info-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 23px;
        height: 23px;
        border: 1px solid rgba(124,140,255,.4);
        border-radius: 50%;
        color: #9ca8ff;
        font-size: 12px;
        font-weight: 700;
    }

    .info-panel strong {
        font-size: 12px;
    }

    .info-panel p {
        margin: 5px 0 0;
        color: #737e90;
        font-size: 11px;
        line-height: 1.6;
    }

</style>

@code {

private readonly List<TelemetryReading> recentTelemetry = new();

private string connectionText = "CONNECTING...";

private int totalReadings;

private TelemetryReading? LatestTemperature =>
    recentTelemetry.FirstOrDefault(
        x => x.Metric.Equals(
            "Temperature",
            StringComparison.OrdinalIgnoreCase));

private TelemetryReading? LatestPower =>
    recentTelemetry.FirstOrDefault(
        x => x.Metric.Equals(
            "Power",
            StringComparison.OrdinalIgnoreCase));

private string LatestTemperatureDisplay =>
    LatestTemperature == null
        ? "--"
        : $"{LatestTemperature.Value:0.##}°C";

private string LatestPowerDisplay =>
    LatestPower == null
        ? "--"
        : $"{LatestPower.Value:0.##} W";

private int ActiveDeviceCount =>
    recentTelemetry
        .Select(x => x.DeviceId)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

protected override async Task OnInitializedAsync()
{
    HubService.TelemetryReceived += HandleTelemetry;

    try
    {
        await HubService.StartAsync();

        connectionText = HubService.IsConnected
            ? "LIVE CONNECTION"
            : "DISCONNECTED";
    }
    catch
    {
        connectionText = "CONNECTION ERROR";
    }
}

private void HandleTelemetry(TelemetryReading reading)
{
    recentTelemetry.Insert(0, reading);

    totalReadings++;

    if (recentTelemetry.Count > 50)
    {
        recentTelemetry.RemoveAt(recentTelemetry.Count - 1);
    }

    _ = InvokeAsync(StateHasChanged);
}

private bool IsAnomalous(TelemetryReading reading)
{
    if (reading.Metric.Equals(
        "Temperature",
        StringComparison.OrdinalIgnoreCase))
    {
        return reading.Value > 70;
    }

    if (reading.Metric.Equals(
        "Power",
        StringComparison.OrdinalIgnoreCase))
    {
        return reading.Value > 2000;
    }

    return false;
}

private void ClearReadings()
{
    recentTelemetry.Clear();
    totalReadings = 0;
}

public void Dispose()
{
    HubService.TelemetryReceived -= HandleTelemetry;
}

}
