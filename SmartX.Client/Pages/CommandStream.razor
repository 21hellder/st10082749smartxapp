@page "/command-stream"
@using System.Net.Http.Json
@using System.Text.Json
@using SmartX.Client.Models
@using SmartX.Client.Services
@implements IDisposable
@inject HttpClient Http
@inject TelemetryHubService HubService

<PageTitle>Smart-X Command Stream</PageTitle>

<div class="command-page">
    <header class="page-header">
        <div>
            <span class="eyebrow">SMART-X / PART 2</span>
            <h1>Command Stream</h1>
            <p>Live telemetry, device controls, alerts and recommendations.</p>
        </div>
        <div class="connection">
            <span class="dot @(HubService.IsConnected ? "online" : "offline")"></span>
            @(HubService.IsConnected ? "LIVE CONNECTION" : "DISCONNECTED")
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="status-message @(statusIsError ? "error" : "success")">
            @statusMessage
        </div>
    }

    <section class="summary-grid">
        <article class="summary-card">
            <span>DEVICES OBSERVED</span>
            <strong>@Devices.Count</strong>
            <small>Devices found in telemetry, sensors and commands</small>
        </article>
        <article class="summary-card">
            <span>TELEMETRY READINGS</span>
            <strong>@recentReadings.Count</strong>
            <small>Readings currently held on this page</small>
        </article>
        <article class="summary-card alert-card">
            <span>ACTIVE ALERTS</span>
            <strong>@ActiveAlertCount</strong>
            <small>Devices with unresolved incidents</small>
        </article>
        <article class="summary-card">
            <span>RECORDED COMMANDS</span>
            <strong>@commands.Count</strong>
            <small>Commands returned by the API</small>
        </article>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">DEVICE EXPLORER</span>
                <h2>Live devices and telemetry</h2>
            </div>
            <button class="small-button"
                    disabled="@isBusy"
                    @onclick="RefreshAllAsync">
                Refresh dashboard
            </button>
        </div>

        <div class="filters">
            <label>
                Search device
                <input value="@searchText"
                       @oninput="HandleSearchInput"
                       placeholder="Enter device ID..." />
            </label>

            <label>
                Device category
                <select @bind="selectedCategory">
                    <option value="All">All categories</option>
                    @foreach (var category in AvailableCategories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </label>

            <label>
                Metric
                <select @bind="selectedMetric">
                    <option value="All">All metrics</option>
                    @foreach (var metric in AvailableMetrics)
                    {
                        <option value="@metric">@metric</option>
                    }
                </select>
            </label>

            <label class="checkbox-label">
                <input type="checkbox" @bind="activeAlertsOnly" />
                Active alerts only
            </label>
        </div>

        @if (FilteredReadings.Count == 0)
        {
            <div class="empty-state">
                <strong>No matching telemetry</strong>
                <span>Send readings to the API or change your filters.</span>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Category</th>
                            <th>Metric</th>
                            <th>Latest value</th>
                            <th>Timestamp</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reading in FilteredReadings)
                        {
                            <tr @key="@($"{reading.DeviceId}|{reading.Metric}")">
                                <td class="device-name">@reading.DeviceId</td>
                                <td>@GetDeviceCategory(reading.DeviceId)</td>
                                <td>@reading.Metric</td>
                                <td class="reading-value">@reading.Value @reading.Unit</td>
                                <td>@reading.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    @if (HasActiveAlert(reading.DeviceId))
                                    {
                                        <span class="pill alert">ACTIVE ALERT</span>
                                    }
                                    else
                                    {
                                        <span class="pill normal">NORMAL</span>
                                    }
                                </td>
                                <td>
                                    <button class="small-button"
                                            @onclick="() => SelectDevice(reading.DeviceId)">
                                        Select
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="two-column">
        <div class="panel">
            <div class="panel-heading">
                <span class="eyebrow">MANUAL OVERRIDE</span>
                <h2>Pump / relay commands</h2>
            </div>

            <div class="command-form">
                <label>
                    Target device
                    <input @bind="selectedDevice"
                           list="known-devices"
                           placeholder="e.g. ESP32-001" />
                    <datalist id="known-devices">
                        @foreach (var device in Devices)
                        {
                            <option value="@device"></option>
                        }
                    </datalist>
                </label>

                <label>
                    Component
                    <select @bind="selectedComponent">
                        <option value="Pump">Pump</option>
                        <option value="Relay">Relay</option>
                    </select>
                </label>

                <label>
                    Action
                    <select @bind="selectedAction">
                        <option value="ON">ON</option>
                        <option value="OFF">OFF</option>
                    </select>
                </label>

                <button class="primary-button"
                        disabled="@isBusy"
                        @onclick="SubmitCommandAsync">
                    @(isBusy ? "Processing..." : "Record command")
                </button>

                <p class="notice">
                    Demo mode: commands are recorded by the API.
                    They do not physically operate hardware.
                </p>
            </div>
        </div>

        <div class="panel">
            <div class="panel-heading">
                <span class="eyebrow">PREDICTIVE RECOMMENDATIONS</span>
                <h2>Suggested actions</h2>
            </div>

            <div class="suggestions">
                @if (recommendations.Count == 0)
                {
                    <div class="empty-state">
                        <strong>No recommendations loaded</strong>
                        <span>Use Refresh dashboard to request the latest insights.</span>
                    </div>
                }
                else
                {
                    @foreach (var recommendation in recommendations)
                    {
                        <article class="suggestion" @key="recommendation">
                            <span class="suggestion-marker">›</span>
                            <div>
                                <strong>@recommendation.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(recommendation.Priority))
                                {
                                    <span class="pill @GetPriorityClass(recommendation.Priority)">
                                        @recommendation.Priority
                                    </span>
                                }
                                <p>@recommendation.Message</p>
                                @if (!string.IsNullOrWhiteSpace(recommendation.DeviceId))
                                {
                                    <button class="small-button"
                                            @onclick="() => SelectDevice(recommendation.DeviceId)">
                                        Select @recommendation.DeviceId
                                    </button>
                                }
                            </div>
                        </article>
                    }
                }
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">COMMAND AUDIT TRAIL</span>
                <h2>Command history</h2>
            </div>
            <button class="small-button"
                    disabled="@isBusy"
                    @onclick="LoadCommandsAsync">
                Refresh history
            </button>
        </div>

        @if (commands.Count == 0)
        {
            <div class="empty-state">
                <strong>No commands returned</strong>
                <span>Record a command above or check that the API is running.</span>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Component</th>
                            <th>Action</th>
                            <th>Issued by</th>
                            <th>Timestamp</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var command in commands)
                        {
                            <tr @key="command.Id">
                                <td class="device-name">@command.DeviceId</td>
                                <td>@command.Component</td>
                                <td><strong>@command.Action</strong></td>
                                <td>@command.IssuedBy</td>
                                <td>@command.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    @if (command.IsUndone)
                                    {
                                        <span class="pill undone">UNDONE</span>
                                    }
                                    else
                                    {
                                        <span class="pill normal">RECORDED</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="history-actions">
                <span class="subtle">
                    Undo marks the latest command as undone in the API history.
                    It does not reverse physical hardware.
                </span>
                <button class="danger-button"
                        disabled="@(isBusy || !commands.Any(c => !c.IsUndone))"
                        @onclick="UndoCommandAsync">
                    Undo latest command
                </button>
            </div>
        }
    </section>

    <footer>
        SMART-X COMMAND STREAM · REAL-TIME TELEMETRY · SIMULATED DEVICE OVERRIDES
    </footer>
</div>

<style>
    .command-page {
        min-height: 100vh;
        padding: 30px;
        background: #080d12;
        color: #e9f1f5;
        font-family: Inter, system-ui, sans-serif;
    }

    .page-header, .panel-heading, .history-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .page-header {
        margin-bottom: 25px;
        padding-bottom: 22px;
        border-bottom: 1px solid #20303a;
    }

    h1 { margin: 7px 0; font-size: 2rem; }
    h2 { margin: 5px 0 0; font-size: 1.05rem; }
    p { color: #84949e; }
    .page-header p { margin: 0; }

    .eyebrow {
        color: #20d6b1;
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: 1.6px;
    }

    .connection {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .7rem;
        letter-spacing: .7px;
    }

    .dot { width: 8px; height: 8px; border-radius: 50%; }
    .online { background: #20d6b1; }
    .offline { background: #e85d75; }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }

    .summary-card, .panel {
        background: #0d151b;
        border: 1px solid #1d2a33;
    }

    .summary-card {
        padding: 20px;
        border-bottom: 2px solid #20d6b1;
    }

    .summary-card.alert-card { border-bottom-color: #e85d75; }
    .summary-card span, .summary-card small {
        display: block;
        color: #758691;
        font-size: .68rem;
    }

    .summary-card strong {
        display: block;
        margin: 10px 0 4px;
        font-size: 1.8rem;
    }

    .panel { margin-bottom: 18px; min-width: 0; }
    .panel-heading { padding: 20px 22px; border-bottom: 1px solid #1d2a33; }
    .panel-heading h2 { margin-top: 6px; }
