@code {
    private const string ApiBase = "http://localhost:5187";
    private const int MaxReadings = 500;
    private const int MaxIncidents = 200;
    private const int MaxCommands = 200;

    // ─────────────────────────────────────────────────────────────
    // RUBRIC DATA STRUCTURES
    // ─────────────────────────────────────────────────────────────

    private readonly Queue<TelemetryReading> telemetryQueue = new();
    private readonly SemaphoreSlim queueSignal = new(0);
    private CancellationTokenSource? queueCts;
    private readonly PriorityQueue<TelemetryIncident, int> alertPriorityQueue = new();
    private readonly Stack<DeviceCommandView> overrideStack = new();
    private readonly Dictionary<string, DeviceState> devicesById =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly SortedDictionary<DateTime, TelemetryReading> telemetryTimeline = new();
    private readonly HashSet<string> activeErrorDevices =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, Dictionary<string, int>> searchToCommandPatterns =
        new(StringComparer.OrdinalIgnoreCase);

    private readonly List<TelemetryReading> recentReadings = new();
    private readonly List<TelemetryIncident> incidents = new();
    private readonly List<DeviceCommandView> commands = new();
    private readonly List<DeviceSensorView> sensors = new();
    private readonly List<RecommendationView> recommendations = new();

    private string searchText = string.Empty;
    private string lastRecordedSearch = string.Empty;
    private string selectedCategory = "All";
    private string selectedMetric = "All";
    private string selectedDevice = "ESP32-001";
    private string selectedComponent = "Pump";
    private string selectedAction = "ON";
    private string statusMessage = string.Empty;

    private bool activeAlertsOnly;
    private bool isBusy;
    private bool statusIsError;
    private bool disposed;

    private List<string> cachedDeviceIds = new();
    private List<string> cachedMetrics = new();
    private List<string> cachedCategories = new();

    private readonly Dictionary<string, DeviceSensorView> sensorsById =
        new(StringComparer.OrdinalIgnoreCase);

    // ─────────────────────────────────────────────────────────────
    // COMPUTED PROPERTIES
    // ─────────────────────────────────────────────────────────────

    private int ActiveAlertCount => activeErrorDevices.Count;
    private List<string> Devices => cachedDeviceIds;
    private List<string> AvailableMetrics => cachedMetrics;
    private List<string> AvailableCategories => cachedCategories;

    private List<TelemetryReading> LatestPerDeviceAndMetric
    {
        get
        {
            var latest = new Dictionary<string, TelemetryReading>(
                StringComparer.OrdinalIgnoreCase);

            foreach (var kvp in telemetryTimeline.Reverse())
            {
                var key = $"{kvp.Value.DeviceId}|{kvp.Value.Metric}";
                if (!latest.ContainsKey(key))
                    latest[key] = kvp.Value;
            }

            return latest.Values.OrderByDescending(r => r.Timestamp).ToList();
        }
    }

    private List<TelemetryReading> FilteredReadings
    {
        get
        {
            IEnumerable<TelemetryReading> q = LatestPerDeviceAndMetric;

            if (!string.IsNullOrWhiteSpace(searchText))
                q = q.Where(r => r.DeviceId.Contains(searchText, StringComparison.OrdinalIgnoreCase));

            if (selectedMetric != "All")
                q = q.Where(r => r.Metric.Equals(selectedMetric, StringComparison.OrdinalIgnoreCase));

            if (selectedCategory != "All")
                q = q.Where(r => GetDeviceCategory(r.DeviceId)
                    .Equals(selectedCategory, StringComparison.OrdinalIgnoreCase));

            if (activeAlertsOnly)
                q = q.Where(r => HasActiveAlert(r.DeviceId));

            return q.ToList();
        }
    }

    // ─────────────────────────────────────────────────────────────
    // LIFECYCLE
    // ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        HubService.TelemetryReceived += HandleTelemetry;
        HubService.IncidentReceived += HandleIncident;

        queueCts = new CancellationTokenSource();
        _ = DrainTelemetryQueueAsync(queueCts.Token);

        await RefreshAllAsync();

        try
        {
            await HubService.StartAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"SignalR connection failed: {ex.Message}", true);
        }
    }

    // ─────────────────────────────────────────────────────────────
    // QUEUE DRAIN
    // ─────────────────────────────────────────────────────────────

    private async Task DrainTelemetryQueueAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && !disposed)
            {
                await queueSignal.WaitAsync(token);

                while (telemetryQueue.TryDequeue(out var reading))
                {
                    ApplyReadingToStructures(reading);
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    // ─────────────────────────────────────────────────────────────
    // SIGNALR HANDLERS
    // ─────────────────────────────────────────────────────────────

    private void HandleTelemetry(TelemetryReading reading)
    {
        if (disposed) return;

        lock (telemetryQueue)
        {
            telemetryQueue.Enqueue(reading);
        }
        queueSignal.Release();
    }

    private void HandleIncident(TelemetryIncident incident)
    {
        if (disposed) return;

        var priority = ClassifyIncidentPriority(incident);
        if (priority <= 1)
        {
            alertPriorityQueue.Enqueue(incident, priority);
            _ = InvokeAsync(ProcessPriorityAlerts);
        }
        else
        {
            _ = InvokeAsync(() =>
            {
                UpsertIncident(incident);
                StateHasChanged();
            });
        }
    }

    private void ProcessPriorityAlerts()
    {
        while (alertPriorityQueue.TryDequeue(out var critical, out _))
        {
            UpsertIncident(critical);
        }
        StateHasChanged();
    }

    private static int ClassifyIncidentPriority(TelemetryIncident i)
    {
        var sev = (i.Severity ?? string.Empty).ToLowerInvariant();
        var metric = (i.Metric ?? string.Empty).ToLowerInvariant();
        var msg = (i.Message ?? string.Empty).ToLowerInvariant();

        if (sev.Contains("critical") || sev.Contains("high")) return 0;
        if (metric.Contains("power") || metric.Contains("moisture")) return 0;
        if (msg.Contains("spike") || msg.Contains("critical")) return 0;
        if (sev.Contains("warning") || sev.Contains("medium")) return 1;
        return 2;
    }

    // ─────────────────────────────────────────────────────────────
    // STRUCTURE UPDATES
    // ─────────────────────────────────────────────────────────────

    private void ApplyReadingToStructures(TelemetryReading reading)
    {
        var key = reading.DeviceId;

        if (!devicesById.TryGetValue(key, out var state))
        {
            state = new DeviceState { DeviceId = key };
            devicesById[key] = state;
        }
        state.LastSeen = reading.Timestamp;
        state.LastMetric = reading.Metric;
        state.LastValue = reading.Value;
        state.LastUnit = reading.Unit;

        var stamp = reading.Timestamp;
        while (telemetryTimeline.ContainsKey(stamp))
            stamp = stamp.AddTicks(1);
        telemetryTimeline[stamp] = reading;

        while (telemetryTimeline.Count > MaxReadings)
        {
            var oldest = telemetryTimeline.Keys.First();
            telemetryTimeline.Remove(oldest);
        }

        // ★ FIX Bug 1: keep recentReadings in sync so summary card updates live
        recentReadings.Insert(0, reading);
        if (recentReadings.Count > MaxReadings)
            recentReadings.RemoveRange(MaxReadings, recentReadings.Count - MaxReadings);

        if (IsReadingAlerting(reading))
            activeErrorDevices.Add(reading.DeviceId);
        else if (!incidents.Any(i =>
            !i.IsResolved &&
            i.DeviceId.Equals(reading.DeviceId, StringComparison.OrdinalIgnoreCase)))
            activeErrorDevices.Remove(reading.DeviceId);
    }

    private static bool IsReadingAlerting(TelemetryReading r) =>
        r.Metric.Contains("moisture", StringComparison.OrdinalIgnoreCase) && r.Value < 20 ||
        r.Metric.Contains("power", StringComparison.OrdinalIgnoreCase) && r.Value > 2400 ||
        r.Metric.Contains("temp", StringComparison.OrdinalIgnoreCase) && r.Value > 45;

    private void UpsertIncident(TelemetryIncident incident)
    {
        var index = incidents.FindIndex(i =>
            !string.IsNullOrWhiteSpace(incident.Id) && i.Id == incident.Id);

        if (index >= 0) incidents[index] = incident;
        else incidents.Insert(0, incident);

        if (incidents.Count > MaxIncidents)
            incidents.RemoveRange(MaxIncidents, incidents.Count - MaxIncidents);

        if (!incident.IsResolved && !string.IsNullOrWhiteSpace(incident.DeviceId))
            activeErrorDevices.Add(incident.DeviceId);
        else if (incident.IsResolved)
            activeErrorDevices.Remove(incident.DeviceId);
    }

    private bool HasActiveAlert(string deviceId) =>
        activeErrorDevices.Contains(deviceId);

    private string GetDeviceCategory(string deviceId)
    {
        if (sensorsById.TryGetValue(deviceId, out var sensor) &&
            !string.IsNullOrWhiteSpace(sensor.Category))
            return sensor.Category;

        return "Unknown";
    }

    // ─────────────────────────────────────────────────────────────
    // LOADERS
    // ─────────────────────────────────────────────────────────────

    private async Task RefreshAllAsync()
    {
        await LoadDashboardDataAsync();
        await LoadCommandsAsync();
        await LoadSensorsAsync();
        await LoadRecommendationsAsync();

        RebuildCaches();
        await InvokeAsync(StateHasChanged);
    }

    private void RebuildCaches()
    {
        cachedDeviceIds = devicesById.Keys.OrderBy(k => k).ToList();
        cachedMetrics = telemetryTimeline.Values
            .Select(r => r.Metric)
            .Where(m => !string.IsNullOrWhiteSpace(m))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(m => m).ToList();
        cachedCategories = sensors
            .Select(s => s.Category)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c).ToList();
    }

    private async Task LoadDashboardDataAsync()
    {
        try
        {
            var readings = await GetCollectionAsync<TelemetryReading>(
                $"{ApiBase}/api/telemetry/history", "readings", "data", "items");

            telemetryTimeline.Clear();
            devicesById.Clear();
            recentReadings.Clear();

            // ApplyReadingToStructures now handles recentReadings — no separate Add
            foreach (var r in readings.OrderBy(r => r.Timestamp))
                ApplyReadingToStructures(r);
        }
        catch (Exception ex)
        {
            SetStatus($"Could not load telemetry: {ex.Message}", true);
        }

        try
        {
            var loadedIncidents = await GetCollectionAsync<TelemetryIncident>(
                $"{ApiBase}/api/incidents", "incidents", "data", "items");

            incidents.Clear();
            activeErrorDevices.Clear();

            foreach (var i in loadedIncidents.Take(MaxIncidents))
                UpsertIncident(i);
        }
        catch (Exception ex)
        {
            SetStatus($"Could not load incidents: {ex.Message}", true);
        }
    }

    private async Task LoadCommandsAsync()
    {
        try
        {
            var loaded = await GetCollectionAsync<DeviceCommandView>(
                $"{ApiBase}/api/commands", "commands", "data", "items");

            commands.Clear();
            commands.AddRange(loaded.OrderByDescending(c => c.Timestamp).Take(MaxCommands));

            overrideStack.Clear();
            foreach (var c in commands.Where(c => !c.IsUndone).OrderBy(c => c.Timestamp))
                overrideStack.Push(c);

            Console.WriteLine($"[LoadCommands] fetched={loaded.Count}, kept={commands.Count}, notUndone={commands.Count(c => !c.IsUndone)}, stackSize={overrideStack.Count}");
        }
        catch (Exception ex)
        {
            SetStatus($"Could not load command history: {ex.Message}", true);
            Console.WriteLine($"[LoadCommands] ERROR: {ex.Message}");
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadSensorsAsync()
    {
        try
        {
            var loaded = await GetCollectionAsync<DeviceSensorView>(
                $"{ApiBase}/api/sensors", "sensors", "data", "items");

            sensors.Clear();
            sensors.AddRange(loaded);

            sensorsById.Clear();
            foreach (var s in loaded)
                if (!string.IsNullOrWhiteSpace(s.DeviceId))
                    sensorsById[s.DeviceId] = s;
        }
        catch (Exception ex)
        {
            SetStatus($"Sensor categories could not be loaded: {ex.Message}", true);
        }
    }

    private async Task LoadRecommendationsAsync()
    {
        var merged = new List<RecommendationView>();
        try
        {
            using var response = await Http.GetAsync($"{ApiBase}/api/recommendations");
            response.EnsureSuccessStatusCode();

            await using var stream = await response.Content.ReadAsStreamAsync();
            using var document = await JsonDocument.ParseAsync(stream);

            var array = FindArray(document.RootElement, "recommendations", "items", "data");
            if (array.HasValue)
            {
                foreach (var item in array.Value.EnumerateArray())
                {
                    merged.Add(new RecommendationView
                    {
                        Title = ReadString(item, "title") ?? "Suggested action",
                        Message = ReadString(item, "message")
                                  ?? ReadString(item, "description")
                                  ?? "Review this recommendation.",
                        Priority = ReadString(item, "priority") ?? string.Empty,
                        DeviceId = ReadString(item, "deviceId") ?? string.Empty
                    });
                }
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Recommendation service: {ex.Message}", true);
        }

        merged.AddRange(GenerateLocalInsights());

        recommendations.Clear();
        recommendations.AddRange(merged);
        await InvokeAsync(StateHasChanged);
    }

    // ─────────────────────────────────────────────────────────────
    // JSON HELPERS
    // ─────────────────────────────────────────────────────────────

    private async Task<List<T>> GetCollectionAsync<T>(
        string url, params string[] propertyNames)
    {
        using var response = await Http.GetAsync(url);
        response.EnsureSuccessStatusCode();

        await using var stream = await response.Content.ReadAsStreamAsync();
        using var document = await JsonDocument.ParseAsync(stream);

        var root = document.RootElement;
        var array = FindArray(root, propertyNames);

        if (!array.HasValue)
        {
            if (root.ValueKind == JsonValueKind.Array)
                array = root;
            else
                throw new InvalidOperationException(
                    $"The response from {url} did not contain a JSON array.");
        }

        var results = new List<T>();
        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

        foreach (var element in array.Value.EnumerateArray())
        {
            var item = JsonSerializer.Deserialize<T>(element.GetRawText(), options);
            if (item is not null) results.Add(item);
        }

        return results;
    }

    private static JsonElement? FindArray(
        JsonElement root, params string[] propertyNames)
    {
        if (root.ValueKind == JsonValueKind.Array) return root;
        if (root.ValueKind != JsonValueKind.Object) return null;

        foreach (var property in root.EnumerateObject())
        {
            if (property.Value.ValueKind == JsonValueKind.Array &&
                propertyNames.Any(name =>
                    property.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
                return property.Value;
        }

        foreach (var property in root.EnumerateObject())
        {
            if (property.Value.ValueKind == JsonValueKind.Array)
                return property.Value;
        }

        return null;
    }

    private static string? ReadString(JsonElement element, string propertyName)
    {
        if (element.ValueKind != JsonValueKind.Object) return null;

        foreach (var property in element.EnumerateObject())
        {
            if (property.Name.Equals(propertyName, StringComparison.OrdinalIgnoreCase))
            {
                if (property.Value.ValueKind == JsonValueKind.String)
                    return property.Value.GetString();

                if (property.Value.ValueKind == JsonValueKind.Number ||
                    property.Value.ValueKind == JsonValueKind.True ||
                    property.Value.ValueKind == JsonValueKind.False)
                    return property.Value.ToString();
            }
        }

        return null;
    }

    // ─────────────────────────────────────────────────────────────
    // PATTERN ANALYSIS
    // ─────────────────────────────────────────────────────────────

    private IEnumerable<RecommendationView> GenerateLocalInsights()
    {
        var output = new List<RecommendationView>();

        foreach (var r in telemetryTimeline.Values)
        {
            if (IsReadingAlerting(r))
            {
                output.Add(new RecommendationView
                {
                    Title = $"Out-of-range: {r.DeviceId} / {r.Metric}",
                    Message = $"Latest value is {r.Value} {r.Unit}, which is outside safe limits. Investigate immediately.",
                    Priority = "Critical",
                    DeviceId = r.DeviceId
                });
            }
        }

        foreach (var (term, targets) in searchToCommandPatterns)
        {
            var top = targets.OrderByDescending(kv => kv.Value).FirstOrDefault();
            if (top.Value >= 2)
            {
                output.Add(new RecommendationView
                {
                    Title = $"Pattern: after '{term}' you usually command {top.Key}",
                    Message = $"You've issued {top.Value} commands to {top.Key} shortly after searching '{term}'. Suggested action pre-loaded.",
                    Priority = "Info",
                    DeviceId = top.Key
                });
            }
        }

        var cutoff = DateTime.UtcNow.AddMinutes(-5);
        foreach (var (id, state) in devicesById)
        {
            if (state.LastSeen < cutoff && !HasActiveAlert(id))
            {
                output.Add(new RecommendationView
                {
                    Title = $"Silent device: {id}",
                    Message = $"No telemetry since {state.LastSeen:HH:mm:ss}. Check power or network.",
                    Priority = "Warning",
                    DeviceId = id
                });
            }
        }

        return output;
    }

    private void RecordPattern(string searchTerm, string deviceId)
    {
        if (string.IsNullOrWhiteSpace(searchTerm) || string.IsNullOrWhiteSpace(deviceId))
            return;

        if (!searchToCommandPatterns.TryGetValue(searchTerm, out var map))
        {
            map = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            searchToCommandPatterns[searchTerm] = map;
        }
        map[deviceId] = map.GetValueOrDefault(deviceId) + 1;
    }

    // ─────────────────────────────────────────────────────────────
    // SEARCH / COMMAND / UNDO
    // ─────────────────────────────────────────────────────────────

    private async Task HandleSearchInput(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        await InvokeAsync(StateHasChanged);

        var term = searchText.Trim();
        if (term.Length >= 3 &&
            !term.Equals(lastRecordedSearch, StringComparison.OrdinalIgnoreCase))
        {
            await RecordSearchAsync(term);
        }
    }

    private async Task RecordSearchAsync(string term)
    {
        term = term.Trim();
        if (term.Length < 3 ||
            term.Equals(lastRecordedSearch, StringComparison.OrdinalIgnoreCase))
            return;

        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"{ApiBase}/api/recommendations/search",
                new SearchRequest { SearchTerm = term });

            if (response.IsSuccessStatusCode)
            {
                lastRecordedSearch = term;
                await LoadRecommendationsAsync();
            }
        }
        catch { }
    }

    // ★ FIX Bug 2: async Task + explicit StateHasChanged
    private async Task SelectDevice(string deviceId)
    {
        selectedDevice = deviceId;
        SetStatus($"Selected device {deviceId}.", false);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SubmitCommandAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedDevice))
        {
            SetStatus("Enter a device ID before recording a command.", true);
            return;
        }

        isBusy = true;
        try
        {
            RecordPattern(lastRecordedSearch, selectedDevice);

            var request = new CreateCommandRequest
            {
                DeviceId = selectedDevice.Trim(),
                Component = selectedComponent,
                Action = selectedAction,
                IssuedBy = "Command Stream Dashboard"
            };

            using var response = await Http.PostAsJsonAsync($"{ApiBase}/api/commands", request);

            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                SetStatus($"API rejected command (HTTP {(int)response.StatusCode}). {details}", true);
                return;
            }

            var localCmd = new DeviceCommandView
            {
                DeviceId = selectedDevice.Trim(),
                Component = selectedComponent,
                Action = selectedAction,
                Timestamp = DateTime.UtcNow,
                IssuedBy = "Command Stream Dashboard"
            };
            overrideStack.Push(localCmd);

            SetStatus($"{selectedAction} recorded for {selectedDevice} ({selectedComponent}).", false);
            await LoadCommandsAsync();
            await LoadRecommendationsAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Could not send command: {ex.Message}", true);
        }
        finally
        {
            isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ★ FIX Bug 3: diagnostics + always POST + surface server errors
    private async Task UndoCommandAsync()
    {
        Console.WriteLine($"[UNDO] entered: isBusy={isBusy}, stackSize={overrideStack.Count}, anyNotUndone={commands.Any(c => !c.IsUndone)}");

        if (isBusy) { Console.WriteLine("[UNDO] bail: isBusy"); return; }

        var hadLocal = overrideStack.TryPop(out var lastLocal);
        Console.WriteLine($"[UNDO] hadLocal={hadLocal}, lastLocal={(lastLocal?.DeviceId ?? "null")}");

        isBusy = true;
        try
        {
            using var response = await Http.PostAsync($"{ApiBase}/api/commands/undo", content: null);
            Console.WriteLine($"[UNDO] POST status={(int)response.StatusCode}");

            if (!response.IsSuccessStatusCode)
            {
                if (hadLocal && lastLocal is not null) overrideStack.Push(lastLocal);

                var details = await response.Content.ReadAsStringAsync();
                SetStatus($"Undo failed (HTTP {(int)response.StatusCode}). {details}", true);
                return;
            }

            await LoadCommandsAsync();
            await LoadRecommendationsAsync();

            var msg = hadLocal && lastLocal is not null
                ? $"Reverted local override: {lastLocal.Action} on {lastLocal.DeviceId} ({lastLocal.Component})."
                : "Undo request completed. Command history refreshed.";
            SetStatus(msg, false);
        }
        catch (Exception ex)
        {
            if (hadLocal && lastLocal is not null) overrideStack.Push(lastLocal);
            SetStatus($"Undo failed: {ex.Message}", true);
            Console.WriteLine($"[UNDO] EXCEPTION: {ex.Message}");
        }
        finally
        {
            isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string GetPriorityClass(string priority)
    {
        if (priority.Contains("critical", StringComparison.OrdinalIgnoreCase) ||
            priority.Contains("high", StringComparison.OrdinalIgnoreCase)) return "critical";
        if (priority.Contains("warning", StringComparison.OrdinalIgnoreCase) ||
            priority.Contains("medium", StringComparison.OrdinalIgnoreCase)) return "warning";
        return "low";
    }

    private void SetStatus(string message, bool isError)
    {
        statusMessage = message;
        statusIsError = isError;
    }

    public void Dispose()
    {
        if (disposed) return;
        disposed = true;

        HubService.TelemetryReceived -= HandleTelemetry;
        HubService.IncidentReceived -= HandleIncident;

        queueCts?.Cancel();
        queueCts?.Dispose();
    }

