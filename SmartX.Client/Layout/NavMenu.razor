
@using Microsoft.AspNetCore.Components.Routing

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            <span class="brand-mark">SX</span>
            <span>SMART-X</span>
        </a>

        <button title="Navigation menu"
                class="navbar-toggler"
                @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-section-label">MONITORING</div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span class="nav-icon">⌂</span>
                <span>Home</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard">
                <span class="nav-icon">◫</span>
                <span>Dashboard</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="telemetry">
                <span class="nav-icon">⌁</span>
                <span>Telemetry</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="incident-radar">
                <span class="nav-icon">!</span>
                <span>Incident Radar</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="command-stream">
                <span class="nav-icon">⇄</span>
                <span>Command Stream</span>
                <span class="part-badge">PART 2</span>
            </NavLink>
        </div>

        <div class="nav-section-label">DEVICE MANAGEMENT</div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sensor-registry">
                <span class="nav-icon">⌘</span>
                <span>Sensor Registry</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="attachments">
                <span class="nav-icon">▤</span>
                <span>Attachments</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <span class="nav-link disabled-link">
                <span class="nav-icon">⌘</span>
                <span>Mesh Routing</span>
                <span class="coming-soon">FINAL</span>
            </span>
        </div>
    </nav>
</div>

<style>
    .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        margin-right: 8px;
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 7px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .navbar-brand {
        display: flex;
        align-items: center;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .nav-section-label {
        padding: 18px 24px 7px;
        color: #667085;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .nav-icon {
        display: inline-flex;
        width: 25px;
        justify-content: center;
        margin-right: 7px;
        font-weight: 700;
    }

    .disabled-link {
        opacity: .45;
        cursor: not-allowed;
    }

    .part-badge, .coming-soon {
        margin-left: auto;
        padding: 2px 6px;
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 4px;
        font-size: 8px;
        letter-spacing: .5px;
    }
</style>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass =>
        collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
